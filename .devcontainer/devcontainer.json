{
  "name": "LegoScanner-Dev",
  "dockerComposeFile": ["../docker-compose.dev.yml"],
  "service": "app", // Tells VS Code which service in compose is the workspace
  "workspaceFolder": "/workspaces/legoscanner",
  "features": {
    // Automatically installs common tools like git, etc.
    "ghcr.io/devcontainers/features/common-utils:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",     // Python support
        "ms-python.vscode-pylance", // Type checking
        "njpwerner.autodocstring",   // Documentation helper
        "ms-toolsai.jupyter", // Jupyter Notebook Dev
        "ms-toolsai.vscode-jupyter" 
      ]
    }
  },
  "remoteUser": "root" 
}